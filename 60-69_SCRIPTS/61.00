#!/bin/bash
# Fase 1 — Pesquisa Diária em Servidores MCP Locais + Web
# Chamado via cron do Aspire às 02:00 BRT
# Saída: lista de novas fontes encontradas

TRATADO="$HOME/repos/tratado-tgd"
FONTES="$TRATADO/50-59_FONTES"
LOG="$TRATADO/60-69_SCRIPTS/log-pesquisa-$(date +%Y%m%d).md"
DATA=$(date "+%Y-%m-%d %H:%M")
NOVAS=0

echo "# Relatório de Pesquisa Diária — $DATA" > "$LOG"
echo "" >> "$LOG"
echo "## Fontes Consultadas" >> "$LOG"

# 1. Acervo SQLite (precedentes novos desde última consulta)
echo "- Acervo SQLite: consultar-precedentes --stats" >> "$LOG"
if command -v consultar-precedentes &>/dev/null; then
    consultar-precedentes --stats >> "$LOG" 2>&1
    echo "  ✅ Acervo SQLite OK" >> "$LOG"
    NOVAS=$((NOVAS+1))
else
    echo "  ⚠️  consultar-precedentes não encontrado" >> "$LOG"
fi

# 2. Zotero — novas notas desde última verificação
echo "- Zotero: extraindo notas recentes..." >> "$LOG"
ZOTERO_DB=~/.zotero/zotero.sqlite
if [ -f "$ZOTERO_DB" ]; then
    sqlite3 "$ZOTERO_DB" "SELECT COUNT(*) FROM items WHERE dateAdded > datetime(now, -1 day);" 2>/dev/null | read NOVAS_NOTAS
    echo "  Notas novas (24h): $NOVAS_NOTAS" >> "$LOG"
    NOVAS=$((NOVAS+1))
else
    echo "  ⚠️  Zotero DB não encontrado em $ZOTERO_DB" >> "$LOG"
fi

# 3. Web — busca por novidades em teoria do direito
if command -v ddgs &>/dev/null; then
    ddgs text -q "teoria geral do direito 2026 filosofia" -m 3 -t w -o json 2>/dev/null | \
        python3 -c "import sys,json; d=json.load(sys.stdin); [print(f\"- {r[title]}: {r[href]}\") for r in d[:3]]" >> "$LOG" 2>&1
    echo "  ✅ DuckDuckGo search OK" >> "$LOG"
    NOVAS=$((NOVAS+1))
fi

echo "" >> "$LOG"
echo "## Novas Fontes Disponíveis: $NOVAS" >> "$LOG"
echo "Próximo passo: fichamento-diario.sh (03:00 BRT)" >> "$LOG"

# Se houver novas fontes, criar um resumo executivo
if [ "$NOVAS" -gt 0 ]; then
    echo "### Resumo" >> "$LOG"
    echo "Pesquisa diária concluída. $NOVAS fontes consultadas." >> "$LOG"
fi

cat "$LOG"
